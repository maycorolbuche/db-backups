#!/usr/bin/env bash
set -euo pipefail

options=${1#--defaults-file=}
directory=$(dirname "$options")
# Preserve paths to the private option file and any CA stored in the checkout.
exec docker run --rm --network host --user "$(id -u):$(id -g)" \
  --volume "$directory:$directory:ro" --volume "$PWD:$PWD:ro" --workdir "$PWD" \
  --entrypoint "$(basename "$0")" mariadb:11.4 "$@"
